{
  "openapi": "3.1.0",
  "info": {
    "title": "PlanIT Control API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/sites": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "List Sites",
        "description": "All sites, highest risk first.",
        "operationId": "list_sites_api_sites_get",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ml",
                    "rules"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Whose risk scores: 'ml' (XGBoost, Predictive) or 'rules' (rules-v2, Real-time). Default: ml.",
              "title": "Model"
            },
            "description": "Whose risk scores: 'ml' (XGBoost, Predictive) or 'rules' (rules-v2, Real-time). Default: ml."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Get Site",
        "operationId": "get_site_api_sites__site_id__get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Site Id"
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ml",
                    "rules"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Whose risk scores: 'ml' (XGBoost, Predictive) or 'rules' (rules-v2, Real-time). Default: ml.",
              "title": "Model"
            },
            "description": "Whose risk scores: 'ml' (XGBoost, Predictive) or 'rules' (rules-v2, Real-time). Default: ml."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List Alerts",
        "description": "Active alerts. With `since`, only alerts updated after that time (includes newly cleared ones).",
        "operationId": "list_alerts_api_alerts_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Site Id"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "include_cleared",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Cleared"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "List Reports",
        "operationId": "list_reports_api_reports_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Create Report",
        "description": "multipart/form-data. The API ties it to the nearest site and resizes the photo (dropping its metadata).",
        "operationId": "create_report_api_reports_post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_report_api_reports_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HazardReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/photos/{photo_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Photo",
        "operationId": "get_photo_api_photos__photo_id__get",
        "parameters": [
          {
            "name": "photo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Photo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/briefings": {
      "get": {
        "tags": [
          "briefings"
        ],
        "summary": "List Briefings",
        "description": "Briefings for a work day. Defaults to tomorrow.",
        "operationId": "list_briefings_api_briefings_get",
        "parameters": [
          {
            "name": "for_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "For Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BriefingList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/briefings/generate": {
      "post": {
        "tags": [
          "briefings"
        ],
        "summary": "Generate Now",
        "description": "Demo button: generate tomorrow's briefings immediately instead of waiting for 6 PM.",
        "operationId": "generate_now_api_briefings_generate_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoAck"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/lightning-replay": {
      "post": {
        "tags": [
          "demo"
        ],
        "summary": "Lightning Replay",
        "description": "Start a storm near a site: strikes arrive every interval_seconds, each one resets the 30-min countdown.\n\nQueued in `job_requests`; the worker picks it up within ~2 s, so the worker must be running.",
        "operationId": "lightning_replay_api_demo_lightning_replay_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LightningReplayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoAck"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "site_id": {
            "type": "integer",
            "title": "Site Id"
          },
          "site_name": {
            "type": "string",
            "title": "Site Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "lightning",
              "flood",
              "heat",
              "storm",
              "wind",
              "wildfire",
              "crew_report",
              "nws"
            ],
            "title": "Type"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "danger"
            ],
            "title": "Severity"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "examples": [
              "STOP WORK: lightning within 10 miles"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "cleared"
            ],
            "title": "Status"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "all_clear_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "All Clear At",
            "description": "Lightning only. Frontend counts down to this. Moves later with each new strike."
          },
          "cleared_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cleared At"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta",
            "examples": [
              {
                "last_strike_at": "2026-10-17T18:42:00Z",
                "nearest_strike_mi": 3.2,
                "strike_count": 4
              }
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "site_id",
          "site_name",
          "type",
          "severity",
          "title",
          "message",
          "status",
          "started_at",
          "all_clear_at",
          "cleared_at",
          "updated_at"
        ],
        "title": "Alert"
      },
      "AlertList": {
        "properties": {
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "type": "array",
            "title": "Alerts"
          },
          "server_time": {
            "type": "string",
            "format": "date-time",
            "title": "Server Time",
            "description": "Pass back as ?since= on the next poll"
          }
        },
        "type": "object",
        "required": [
          "alerts",
          "server_time"
        ],
        "title": "AlertList"
      },
      "Body_create_report_api_reports_post": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "hazard_type": {
            "type": "string",
            "enum": [
              "wildlife",
              "flooding",
              "unstable_ground",
              "downed_line",
              "heat_illness",
              "fire",
              "other"
            ],
            "title": "Hazard Type"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Severity"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "reporter_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporter Name"
          },
          "photo": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "hazard_type",
          "severity"
        ],
        "title": "Body_create_report_api_reports_post"
      },
      "Briefing": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "site_id": {
            "type": "integer",
            "title": "Site Id"
          },
          "site_name": {
            "type": "string",
            "title": "Site Name"
          },
          "for_date": {
            "type": "string",
            "format": "date",
            "title": "For Date"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "examples": [
              "Start before 7 AM. Heat index reaches 110\u00b0F by noon; storms likely after 2 PM."
            ]
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "examples": [
              {
                "peak_heat_index_f": 110,
                "recommendations": [
                  "Water/rest/shade every hour after 11 AM"
                ],
                "risk_score": 7.4,
                "storm_window": "2 PM - 6 PM"
              }
            ]
          },
          "generated_by": {
            "type": "string",
            "title": "Generated By",
            "examples": [
              "gemini-2.5-flash",
              "template"
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "site_id",
          "site_name",
          "for_date",
          "summary",
          "generated_by",
          "generated_at"
        ],
        "title": "Briefing"
      },
      "BriefingList": {
        "properties": {
          "for_date": {
            "type": "string",
            "format": "date",
            "title": "For Date"
          },
          "briefings": {
            "items": {
              "$ref": "#/components/schemas/Briefing"
