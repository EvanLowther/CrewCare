            "type": "array",
            "title": "Briefings"
          }
        },
        "type": "object",
        "required": [
          "for_date",
          "briefings"
        ],
        "title": "BriefingList"
      },
      "Conditions": {
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "temp_f": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp F"
          },
          "heat_index_f": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heat Index F"
          },
          "humidity_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Humidity Pct"
          },
          "precip_in": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precip In"
          },
          "precip_prob_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precip Prob Pct"
          },
          "wind_mph": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wind Mph"
          },
          "gust_mph": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gust Mph"
          },
          "cape_jkg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cape Jkg"
          },
          "soil_moisture": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Soil Moisture",
            "description": "m3/m3, 0-7 cm"
          },
          "weather_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weather Code"
          }
        },
        "type": "object",
        "required": [
          "ts",
          "temp_f",
          "heat_index_f",
          "humidity_pct",
          "precip_in",
          "precip_prob_pct",
          "wind_mph",
          "gust_mph",
          "cape_jkg",
          "soil_moisture",
          "weather_code"
        ],
        "title": "Conditions"
      },
      "DemoAck": {
