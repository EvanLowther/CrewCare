# /opt/planit/.env on the server (never commit the real one). Fill in the two secrets.
PLANIT_DATABASE_URL=
PLANIT_MOCK=0
PLANIT_GEMINI_API_KEY=
# PLANIT_GEMINI_MODEL is optional: leave it out to use config.py's model and its fallbacks.
PLANIT_SCORE_MODEL=xgb
# Login (docs/AUTH.md). Never set PLANIT_AUTH_DEV here.
PLANIT_AUTH0_DOMAIN=
PLANIT_AUTH0_AUDIENCE=
PLANIT_ADMIN_EMAILS=
PLANIT_PHOTO_SIGNING_KEY=

# Website sign-in (Auth0 Next.js SDK). AUTH0_SECRET: any random 32+ byte hex string.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=https://api.planit-control
APP_BASE_URL=https://crewcare.207-246-119-236.sslip.io
# Web Push to phones and browsers: `python scripts/vapid_keys.py` (from backend/) prints both. Keep them for good;
# a new pair means every device turns notifications on again.
PLANIT_VAPID_PUBLIC_KEY=
PLANIT_VAPID_PRIVATE_KEY=
PLANIT_NWS_USER_AGENT=PlanIT Control (SwampHacks project, contact@example.com)
