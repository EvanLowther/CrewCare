# Installed to /etc/caddy/Caddyfile by deploy/bootstrap.sh, with PLANIT_HOST replaced by the real hostname.
# The site's block must stay first: deploy.sh reads the hostname from the first block of the installed file.
# Caddy gets and renews the HTTPS certificate on its own. deploy.sh reinstalls it when this file changes.
#
# Every deploy restarts the API (and the website when it changed), which takes a few seconds. lb_try_duration makes
# Caddy hold a request and keep retrying the connection instead of answering 502 Bad Gateway, so nobody sees an error.
PLANIT_HOST {
	encode zstd gzip

	# FastAPI directly, so photo uploads don't pass through the Next.js proxy.
	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy 127.0.0.1:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# The address before the Crew Care rename: links already shared keep working and land on the new one.
planit.207-246-119-236.sslip.io {
	redir https://PLANIT_HOST{uri} permanent
}
