# Copy to .env (never commit .env).

# Tiger Data connection string: run `tiger db uri` and paste the result here.
PLANIT_DATABASE_URL=

# 1 = serve sample data from backend/planit/api/mock.py instead of the database.
PLANIT_MOCK=1

# Gemini, for the 6 PM briefing text. Leave blank to use the plain template.
PLANIT_GEMINI_API_KEY=
PLANIT_GEMINI_MODEL=gemini-2.5-flash

# Hazard score: xgb = the trained ML model (falls back to rules-v1 if there's none), rules = rules-v1 only.
PLANIT_SCORE_MODEL=xgb

# Login (docs/AUTH.md). On a laptop, PLANIT_AUTH_DEV=1 gives a "Sign in as" menu with fake users instead of Auth0.
PLANIT_AUTH_DEV=1
PLANIT_AUTH0_DOMAIN=
PLANIT_AUTH0_AUDIENCE=
PLANIT_ADMIN_EMAILS=

# Required by api.weather.gov. Put a contact email in it.
PLANIT_NWS_USER_AGENT=PlanIT Control (hackathon project, contact@example.com)
